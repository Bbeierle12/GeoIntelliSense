# ─────────────────────────────────────────────────────────────────────────────
# Backend configuration for `docker compose up` (copy to .env).
# Every variable has a default; the stack starts with an empty .env.
# The frontend's own settings live in .env.local (see .env.local.example).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database / ports (defaults shown) ────────────────────────────────────────
POSTGRES_USER=geointellisense
POSTGRES_PASSWORD=geointellisense_dev
POSTGRES_DB=geointellisense
DB_PORT=5432
REDIS_PORT=6379
INGESTION_PORT=3001
ANALYTICS_PORT=3002
GATEWAY_PORT=8080

# ── Live data sources (all optional; the app runs on mock/keyless data without them)
# Live neighbourhood AQI from PurpleAir sensors (without it: simulated AQI)
#   https://develop.purpleair.com/
PURPLEAIR_API_KEY=
# Official EPA AirNow observations/forecasts
#   https://docs.airnowapi.org/account/request/
AIRNOW_API_KEY=
# Active fire detections (NASA FIRMS "MAP_KEY")
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_KEY=
# Historical weather (NOAA Climate Data Online token)
#   https://www.ncdc.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=
# EPA AQS historical summaries
#   https://aqs.epa.gov/data/api/signup
EPA_AQS_EMAIL=
EPA_AQS_KEY=
# Census ACS demographics
#   https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ── AI chat / analysis (Claude) ──────────────────────────────────────────────
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Interactive map (Maps JavaScript API) ────────────────────────────────────
#   https://console.cloud.google.com/google/maps-apis/
GOOGLE_MAPS_API_KEY=

# ── Optional hardening ───────────────────────────────────────────────────────
# When set, admin endpoints require this token and CORS is restricted to
# ALLOWED_ORIGINS plus the built-in dev/mobile origins.
ADMIN_TOKEN=
# Comma-separated extra browser origins (e.g. https://app.example.com)
ALLOWED_ORIGINS=

# ── Polling intervals (seconds) ──────────────────────────────────────────────
PURPLEAIR_INTERVAL_SECS=600
BROADCAST_INTERVAL_SECS=5
