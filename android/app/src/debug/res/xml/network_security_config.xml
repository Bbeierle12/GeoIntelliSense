<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only policy: allow cleartext so a sideloaded debug APK can reach a
     development server on the local network (http://192.168.x.x:8080).
     The release policy in src/main/res/xml blocks all cleartext traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
