# Gemini API Key (Required for Chat and Analysis features)
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key (Required for Interactive Map feature)
# Get it from: https://console.cloud.google.com/google/maps-apis/
# Make sure to enable "Maps JavaScript API" for your project
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend server port (optional, defaults to 3001)
PORT=3001
