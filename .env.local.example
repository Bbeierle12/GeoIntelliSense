# Anthropic API Key (Required for Chat and Analysis features)
# Get it from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PurpleAir API Key (Optional — enables live sensor data instead of mock)
# Get it from: https://develop.purpleair.com/
PURPLEAIR_API_KEY=

# Google Maps API Key (Required for Interactive Map feature)
# Get it from: https://console.cloud.google.com/google/maps-apis/
# Make sure to enable "Maps JavaScript API" for your project
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Frontend API routing (Vite)
# Development defaults fall back to localhost when these are not set.
VITE_GATEWAY_URL=http://localhost:8080
VITE_INGESTION_URL=http://localhost:3001

# Production/mobile builds MUST use public absolute HTTPS URLs:
# VITE_GATEWAY_URL=https://api.your-domain.com
# VITE_INGESTION_URL=https://ingestion.your-domain.com

# Development-only admin token for local source toggles in Settings (optional)
VITE_ADMIN_TOKEN=
